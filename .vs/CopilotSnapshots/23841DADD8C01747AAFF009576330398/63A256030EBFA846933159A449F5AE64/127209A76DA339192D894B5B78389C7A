<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login</title>
  <script>
    // If the SPA has an internal /login route, prefer it.
    // If it doesn't, we fall back to the hosted Base44 login page.
    var fromUrl = window.location.origin + '/';
    try {
      // Route within this app
      window.location.replace('/login?from_url=' + encodeURIComponent(fromUrl));
    } catch (e) {
      window.location.replace('https://tots-toy-fun.base44.app/login?from_url=' + encodeURIComponent(fromUrl));
    }
  </script>
</head>
<body>
  <p>Redirecting to login...</p>
  <p><a href="/login">Continue</a></p>
</body>
</html>